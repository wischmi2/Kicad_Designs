		)
		(pin "1"
			(uuid "3ca13594-39ce-4522-985c-cee86c018aad")
		)
		(instances
			(project "feather_orp"
				(path "/55da176d-6431-4d58-ada7-b89d931b1434/fe2ea5fc-ce63-47c3-bd94-3fdd0b559ca6"
					(reference "R3")
					(unit 1)
				)
			)
		)
	)
	(text "ISOLATION BLOCK (SN6505B option c', 2026-10-28 trial on feather_orp). Host side = GND, isolated side = GND_ISO.\nU3 ISO1640BDR 2-ch I2C isolator: side 1 (pins 1-4) = isolated, VDD_ISO; side 2 (pins 5-8) = host, VSENS (VOL2 0.4 V for the nRF).\nU5 SN6505B push-pull driver from VSENS via FB1 (EN tied to VCC, CLK to GND), T1 Wurth 760390015 1:2 CT/CT, D1 BAT54C full-wave,\nU6 LP2985-33: VDD_ISO 3.3 V regulated. VISO_RAW about 4.9-5.5 V loaded, about 6.6 V max at no load (LP2985 16 V max).\nR3/R4 4.7k: I2C pull-ups on the ISOLATED side only. J5: INT_ISO test pad (2-channel isolator, INT is poll-only).\nNon-isolated board: delete this sheet, tie the Sensor sheet pins to VSENS / GND / SENS_SDA / SENS_SCL / SENS_INT instead (see README.md)."
		(exclude_from_sim no)
		(at 40.64 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "79e3e9d2-c5be-49c2-8942-04aa2bfa730d")
	)
