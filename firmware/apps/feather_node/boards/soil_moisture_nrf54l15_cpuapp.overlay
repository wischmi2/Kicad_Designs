/* Pouch credentials live on LittleFS in the storage partition. */
/ {
	fstab {
		compatible = "zephyr,fstab";
		lfs1: lfs1 {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/lfs1";
			partition = <&storage_partition>;
			automount;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};

/* The soil_moisture board file predates these fixes (see the feather board file):
 * no 32 kHz crystal, and SCL on P1.03 is an NFC pin.
 */
&lfxo {
	status = "disabled";
};

&uicr {
	nfct-pins-as-gpios;
};

&nfct {
	status = "disabled";
};
