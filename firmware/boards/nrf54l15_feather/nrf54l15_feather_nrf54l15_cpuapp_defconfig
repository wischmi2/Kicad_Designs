CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y

# Only what every image needs lives here (MCUboot builds with this file too, and the
# nPM1300 MFD/regulator/sensor drivers do not link in MCUboot's minimal kernel).
# Console, logging (RTT), I2C, MFD, regulator, sensor and ADC are set in the app's
# prj.conf and boards\*.conf.

# X2 (32.768 kHz) is DNP: use the internal LF RC for LFCLK and the GRTC system timer.
# Without these the default LFXO makes the GRTC wait forever at boot.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_NRF_GRTC_TIMER_SOURCE_LFLPRC=y
